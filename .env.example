# App web (apps/web/.env) ───────────────────────────────────────────────────
# As chaves `publishable` são seguras no cliente: quem protege os dados é o RLS
# do Postgres, não o segredo da chave. Nunca coloque aqui uma `service_role`.
#
# O prefixo VITE_ é o que expõe a variável ao bundle do navegador; as versões
# sem prefixo são lidas pelo servidor de SSR.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# App mobile: ver apps/mobile/.env.example (o Expo usa o prefixo EXPO_PUBLIC_).
